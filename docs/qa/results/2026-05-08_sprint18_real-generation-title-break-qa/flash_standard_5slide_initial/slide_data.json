   gap: 24px;\n    margin-bottom: 48px;\n  }\n\n  .eyebrow-line {\n    width: 96px;\n    height: 1px;\n    background: #D4A574;\n  }\n\n  .eyebrow-text {\n    font-size: 22px;\n    font-weight: 400;\n    color: #D4A574;\n    letter-spacing: 0.5em;\n  }\n\n  .number-mark {\n    font-size: 220px;\n    font-weight: 900;\n    line-height: 0.85;\n    background: linear-gradient(135deg, #FBBF24 0%, #D4A574 60%, #A88556 100%);\n    -webkit-background-clip: text;\n    background-clip: text;\n    -webkit-text-fill-color: transparent;\n    margin-bottom: 36px;\n    letter-spacing: -0.03em;\n  }\n\n  .title {\n    font-size: 88px;\n    font-weight: 900;\n    color: #FFFFFF;\n    line-height: 1.15;\n    white-space: normal;\n    letter-spacing: 0.04em;\n    margin-bottom: 44px;\n    overflow: visible;\n    overflow-wrap: normal;\n    word-break: normal;\n    text-wrap: balance;\n  }\n\n  .accent-bar {\n    width: 280px;\n    height: 4px;\n    background: linear-gradient(to right, #D4A574, transparent);\n    margin-bottom: 36px;\n  }\n\n  .subtle-text {\n    font-size: 26px;\n    font-weight: 400;\n    color: rgba(255, 255, 255, 0.55);\n    letter-spacing: 0.35em;\n  }\n\n  .slide-number {\n    position: absolute;\n    right: 80px;\n    bottom: 60px;\n    font-size: 20px;\n    color: rgba(212, 165, 116, 0.75);\n    letter-spacing: 0.3em;\n    font-weight: 400;\n  }\n\n  .top-border {\n    position: absolute;\n    top: 60px;\n    right: 80px;\n    width: 320px;\n    height: 1px;\n    background: rgba(212, 165, 116, 0.45);\n  }\n\n  .top-border-dot {\n    position: absolute;\n    top: 57px;\n    right: 76px;\n    width: 7px;\n    height: 7px;\n    background: #D4A574;\n    border-radius: 50%;\n  }\n</style>\n</head>\n<body>\n<div class=\"left-decoration\">\n<div class=\"circle-decor\"></div>\n<div class=\"circle-ring\"></div>\n<div class=\"thin-line-1\"></div>\n<div class=\"thin-line-2\"></div>\n<div class=\"geo-square\"></div>\n<div class=\"geo-dot\"></div>\n<div class=\"section-