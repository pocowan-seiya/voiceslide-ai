 }\n  .corner-bl { bottom: 60px; left: 60px; border-right: none; border-top: none; }\n  .corner-br { bottom: 60px; right: 60px; border-left: none; border-top: none; }\n  \n  .content {\n    text-align: center;\n    position: relative;\n    z-index: 10;\n  }\n  \n  .eyebrow {\n    font-size: 22px;\n    font-weight: 400;\n    letter-spacing: 0.8em;\n    color: #D4A574;\n    margin-bottom: 56px;\n    text-transform: uppercase;\n    padding-left: 0.8em;\n  }\n  \n  .number-wrap {\n    position: relative;\n    display: inline-block;\n    margin-bottom: 32px;\n  }\n  \n  .section-number {\n    font-family: 'Cormorant Garamond', 'Noto Sans JP', serif;\n    font-size: 320px;\n    font-weight: 500;\n    line-height: 1;\n    background: linear-gradient(135deg, #FFFFFF 0%, #E8D4B8 55%, #D4A574 100%);\n    -webkit-background-clip: text;\n    background-clip: text;\n    -webkit-text-fill-color: transparent;\n    letter-spacing: -0.02em;\n    position: relative;\n  }\n  \n  .number-label {\n    position: absolute;\n    top: 30px;\n    right: -90px;\n    font-size: 18px;\n    font-weight: 400;\n    letter-spacing: 0.4em;\n    color: rgba(212, 165, 116, 0.75);\n    writing-mode: vertical-rl;\n  }\n  \n  .accent-line {\n    width: 140px;\n    height: 1px;\n    background: linear-gradient(90deg, transparent, #D4A574, transparent);\n    margin: 8px auto 48px;\n    position: relative;\n  }\n  \n  .accent-line::after {\n    content: '';\n    position: absolute;\n    top: 50%;\n    left: 50%;\n    transform: translate(-50%, -50%) rotate(45deg);\n    width: 8px;\n    height: 8px;\n    background: #D4A574;\n  }\n  \n  .section-title {\n    font-size: 96px;\n    font-weight: 700;\n    color: #FFFFFF;\n    letter-spacing: 0.15em;\n    word-break: keep-all;\n    white-space: normal;\n    line-height: 1.2;\n    max-width: 90%;\n    margin: 0 auto;\n    padding-left: 0.15em;\n  }\n  \n  .slide-number {\n    position: absolute;\n    bottom: 50px;\n    right: 80px;\n    font-size: 15px;\n    font