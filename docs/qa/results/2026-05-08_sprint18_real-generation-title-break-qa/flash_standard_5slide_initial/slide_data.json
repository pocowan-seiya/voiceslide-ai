">\n<head>\n<meta charset=\"utf-8\"/>\n<title>セクション 1</title>\n<link href=\"https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;900&amp;display=swap\" rel=\"stylesheet\"/>\n<style>\n  * { margin: 0; padding: 0; box-sizing: border-box; }\n  \n  body {\n    width: 1920px;\n    height: 1080px;\n    font-family: 'Noto Sans JP', sans-serif;\n    background: linear-gradient(135deg, #0F1E2E 0%, #1E3A5F 100%);\n    position: relative;\n    overflow: hidden;\n    padding: 40px 50px !important;\n    display: flex;\n    align-items: center;\n    justify-content: center;\n  }\n  \n  /* 背景装飾 - グラデーション円 */\n  .bg-circle-1 {\n    position: absolute;\n    width: 1000px;\n    height: 1000px;\n    border-radius: 50%;\n    background: radial-gradient(circle, rgba(74, 144, 164, 0.22) 0%, transparent 70%);\n    top: -320px;\n    right: -220px;\n    filter: blur(40px);\n  }\n  \n  .bg-circle-2 {\n    position: absolute;\n    width: 800px;\n    height: 800px;\n    border-radius: 50%;\n    background: radial-gradient(circle, rgba(212, 165, 116, 0.14) 0%, transparent 70%);\n    bottom: -280px;\n    left: -180px;\n    filter: blur(50px);\n  }\n  \n  /* 光の粒子 */\n  .particle {\n    position: absolute;\n    border-radius: 50%;\n    background: #D4A574;\n    box-shadow: 0 0 20px rgba(212, 165, 116, 0.8);\n  }\n  .p1 { width: 6px; height: 6px; top: 20%; left: 15%; opacity: 0.7; }\n  .p2 { width: 4px; height: 4px; top: 70%; left: 25%; opacity: 0.5; }\n  .p3 { width: 8px; height: 8px; top: 30%; right: 20%; opacity: 0.6; }\n  .p4 { width: 5px; height: 5px; top: 80%; right: 18%; opacity: 0.7; }\n  .p5 { width: 3px; height: 3px; top: 15%; right: 35%; opacity: 0.5; }\n  .p6 { width: 7px; height: 7px; bottom: 25%; left: 40%; opacity: 0.4; }\n  .p7 { width: 4px; height: 4px; top: 45%; left: 8%; opacity: 0.5; }\n  .p8 { width: 5px; height: 5px; bottom: 35%; right: 10%; opacity: 0.6; }\n  \n  /* 幾何学ライン装飾 */\n  .geo-line-top {\n    position: absolute;\n    top: 100px;\n    left: 50%;\n    transform: translateX(-50%);\n    width: 160px;\n    height: 1px;\n    background: linear-gradient(90deg, transparent, #D4A574, transparent);\n  }\n  \n  .geo-line-bottom {\n    position: absolute;\n    bottom: 100px;\n    left: 50%;\n    transform: translateX(-50%);\n    width: 160px;\n    height: 1px;\n    background: linear-gradient(90deg, transparent, #D4A574, transparent);\n  }\n  \n  /* メインコンテンツ */\n  .hero {\n    position: relative;\n    z-index: 10;\n    text-align: center;\n    max-width: 1500px;\n  }\n  \n  .eyebrow {\n    font-size: 24px;\n    font-weight: 500;\n    letter-spacing: 0.55em;\n    color: #D4A574;\n    margin-bottom: 50px;\n    text-transform: uppercase;\n  }\n  \n  .eyebrow-line {\n    display: inline-block;\n    width: 70px;\n    height: 1px;\n    background: #D4A574;\n    vertical-align: middle;\n    margin: 0 28px;\n  }\n  \n  .section-number {\n    font-size: 220px;\n    font-weight: 900;\n    color: rgba(212, 165, 116, 0.13);\n    line-height: 1;\n    letter-spacing: 0.05em;\n    margin-bottom: -70px;\n    font-family: 'Noto Sans JP', sans-serif;\n  }\n  \n  .title {\n    font-size: 108px;\n    font-weight: 900;\n    line-height: 1.15;\n    background: linear-gradient(135deg, #FFFFFF 0%, #D4A574 100%);\n    -webkit-background-clip: text;\n    background-clip: text;\n    -webkit-text-fill-color: transparent;\n    letter-spacing: 0.04em;\n    text-align: center;\n    margin: 0 auto;\n    padding: 0 20px;\n    position: relative;\n    white-space: normal;\n    overflow: visible;\n    overflow-wrap: normal;\n    word-break: normal;\n    line-break: strict;\n    text-wrap: balance;\n  }\n  \n  .accent-bar {\n    width: 120px;\n    height: 4px;\n    background: linear-gradient(90deg, #D4A574, #4A90A4);\n    margin: 56px auto 0;\n    border-radius: 2px;\n  }\n  \n  /* スライド番号 */\n  .slide-number {\n    position: absolute;\n    bottom: 50px;\n    right: 60px;\n    font-size: 16px;\n    color: rgba(255, 255, 255, 0.45);\n    letter-spacing: 0.25em;\n    font-weight: 500;\n    z-index: 10;\n  }\n  \n  .brand-mark {\n    position: absolute;\n    top: 50px;\n    left: 60px;\n    font-size: 22px;\n    color: rgba(255, 255, 255, 0.55);\n    letter-spacing: 0.4em;\n    font-weight: 700;\n    z-index: 10;\n  }\n  \n  .corner-tl, .corner-br {\n    position: absolute;\n    width: 70px;\n    height: 70px;\n    border: 1px solid rgba(212, 165, 116, 0.45);\n  }\n  .corner-tl { top: 40px; left: 40px; border-right: none; border-bottom: none; }\n  .corner-br { bottom: 40px; right: 40px; border-left: none; border-top: none; }\n</style>\n</head>\n<body>\n<div class=\"bg-circle-1\"></div>\n<div class=\"bg-circle-2\"></div>\n<div class=\"particle p1\"></div>\n<div class=\"particle p2\"></div>\n<div class=\"particle p3\"></div>\n<div class=\"particle p4\"></div>\n<div class=\"particle p5\"></div>\n<div class=\"particle p6\"></div>\n<div class=\"particle p7\"></div>\n<div class=\"particle p8\"></div>\n<div class=\"corner-tl\"></div>\n<div class=\"corner-br\"></div>\n<div class=\"geo-line-top\"></div>\n<div class=\"geo-line-bottom\"></div>\n<div class=\"brand-mark\">PRESENTATION</div>\n<div class=\"hero\">\n<div class=\"eyebrow\"><span class=\"eyebrow-line\"></span>CHAPTER 01<span class=\"eyebrow-line\"></span></div>\n<div class=\"section-number\">01</div>\n<h1 class=\"title\">セクション 1</h1>\n<div class=\"accent-bar\"></div>\n</div>\n<div class=\"slide-number\">01 / 05</div>\n</body>\n</html>", "<!DOCTYPE html>\n\n<html lang=\"ja\">\n<head>\n<meta charset=\"utf-8\"/>\n<title>セクション 2</title>\n<link href=\"https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;700;900&amp;display=swap\" rel=\"stylesheet\"/>\n<style>\n  * { margin: 0; padding: 0; box-sizing: border-box; }\n  \n  body {\n    width: 1920px;\n    height: 1080px;\n    font-family: 'Noto Sans JP', sans-serif;\n    background: linear-gradient(110deg, #0A1828 0%, #0F1E2E 35%, #1E3A5F 100%);\n    overflow: hidden;\n    position: relative;\n    padding: 0 !important;