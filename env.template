# VoiceSlide AI 環境変数テンプレート（本番用）
# このファイルを .env.production にリネームしてください

# ========== 認証 ==========
# アクセスパスワード（必須）
ACCESS_PASSWORD=your_secure_password_here

# ========== APIキー（オプション：ユーザー持ち込み時は不要）==========
# デフォルトのAPIキー（ユーザーが入力しない場合に使用）
# OPENAI_API_KEY=sk-xxx
# GEMINI_API_KEY=xxx

# ========== サーバー設定 ==========
# フロントエンドURL（CORS用）
NEXT_PUBLIC_API_URL=http://localhost:8000

# ========== ファイル保存 ==========
# 出力ディレクトリ
OUTPUT_DIR=/app/outputs
UPLOAD_DIR=/app/uploads

# ========== オプション ==========
# デバッグモード
DEBUG=false
