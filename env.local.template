# VoiceSlide AI ローカル開発用環境変数
# このファイルを .env.local にリネームして使用してください

# ========== APIキー ==========
# ブラウザから入力するため、ここでの設定は不要です
# （設定した場合はデフォルト値として使用されます）
# OPENAI_API_KEY=sk-xxx
# GEMINI_API_KEY=xxx

# ========== サーバー設定 ==========
# バックエンドURL（ローカル）
NEXT_PUBLIC_API_URL=http://localhost:8000

# ========== ファイル保存 ==========
# 出力ディレクトリ（相対パス）
OUTPUT_DIR=./outputs
UPLOAD_DIR=./uploads

# ========== デバッグ ==========
DEBUG=true
