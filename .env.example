# VoiceSlide AI 環境変数設定例
# Railwayなどの本番環境でこれらの変数を設定してください

# ========== 🔐 認証設定 (必須) ==========
# サイト全体を保護するパスワード。これを設定するとログイン画面が有効になります。
SITE_PASSWORD=your-secret-password-here

# ========== 🤖 AI APIキー (必須) ==========
# 文字起こしやスライド生成に使用します
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ========== ⚙️ サーバー設定 (通常は変更不要) ==========
# フロントエンドからバックエンドへの接続URL
# Railway等の単一コンテナ構成では、Next.jsのRewrites機能を使うため空文字でOKです。
# 開発環境でポートを分けている場合のみ http://localhost:8001 を指定します。
NEXT_PUBLIC_API_URL=

# ファイル保存ディレクトリ（Railway等の場合、永続化ボリュームをマウントするパス）
OUTPUT_DIR=/app/outputs
UPLOAD_DIR=/app/uploads

# ========== ☁️ Supabase Storage (音声ファイル永続化・推奨) ==========
# Railway コンテナはエフェメラル（デプロイで /app/uploads が消える）なので、
# 音声ファイルを Supabase Storage に永続化するための設定。未設定でも動作するが、
# 再デプロイ後のプロジェクト復元で毎回音声の再アップロードが必要になります。
# 設定すると自動的に audios バケット（supabase_migration_audio_storage.sql で作成）
# にアップロード／復元されます。
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ========== 🐛 その他 ==========
# 詳細なログを出力するかどうか
DEBUG=false
